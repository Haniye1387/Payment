
    

@model Payment.Models.ChangePassword
@{
    ViewData["Title"] = "Change password ";
}


    <form class="form" asp-controller="ChangePassword" asp-action="ChangePassword" method="post">

        <div class="title">
            Change Password
        </div>

        <input class="input"
               name="UserName"
               placeholder="Username" />

        <input class="input"
               name="NewPassword"
               type="password"
               placeholder="New Password" />

        @if (ViewBag.Success != null)
        {
            <p class="success">@ViewBag.Success</p>
        }

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <button class="button-confirm" type="submit">
            Change Password
        </button>

        <button class="button-confirm"
                type="button"
                onclick="location.href='@Url.Action("Login", "Login")'">
            Back to login
        </button>

    </form>

