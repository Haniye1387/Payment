@{
}@{
    Layout = null;
}

@model Payment.Models.ChangePassword

<!DOCTYPE html>
<html>
<head>
    <title>Change Password</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: beige;
        }

        .form {
            --input-focus: #2d8cf0;
            --font-color: #323232;
            --font-color-sub: #666;
            --bg-color: beige;
            --main-color: black;
            width: 300px;
            padding: 20px;
            background: lightblue;
            display: flex;
            flex-direction: column;
            gap: 20px;
            border-radius: 5px;
            border: 2px solid var(--main-color);
            box-shadow: 4px 4px var(--main-color);
        }

        .title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        .input {
            width: 100%;
            height: 40px;
            padding: 8px;
            border: 2px solid black;
            border-radius: 5px;
            background: beige;
            box-shadow: 4px 4px black;
        }

        .button-confirm {
            height: 40px;
            border: 2px solid black;
            border-radius: 5px;
            background: beige;
            box-shadow: 4px 4px black;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

            .button-confirm:active {
                box-shadow: 0px 0px black;
                transform: translate(3px,3px);
            }

        .success {
            color: green;
            text-align: center;
            font-weight: bold;
        }

        .error {
            color: red;
            text-align: center;
            font-weight: bold;
        }
    </style>

</head>

<body>

    <form class="form" asp-controller="ChangePassword" asp-action="ChangePassword" method="post">

        <div class="title">
            Change Password
        </div>

        <input class="input"
               name="UserName"
               placeholder="Username" />

        <input class="input"
               name="NewPassword"
               type="password"
               placeholder="New Password" />

        @if (ViewBag.Success != null)
        {
            <p class="success">@ViewBag.Success</p>
        }

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <button class="button-confirm" type="submit">
            Change Password
        </button>

        <button class="button-confirm"
                type="button"
                onclick="location.href='@Url.Action("Login", "Login")'">
            Back
        </button>

    </form>

</body>
</html>
