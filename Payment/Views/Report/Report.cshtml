
@model List<Payment.Models.ReportModel>

@{
    ViewData["Title"] = "Report";
}
    <div class="form">
        
        <div class="title">Report<br></div>
        <table class="table-report">
    <thead>
        <tr>
            <th>User Name</th>
            <th>Date</th>
            <th>Total Price</th>
        </tr>
    </thead>

    <tbody>
        
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.UserName</td>
            <td>@item.Date</td>
            <td>@item.TotalPrice</td>
        </tr>
    }

    </tbody>

</table>
        <div class="login-with">
        </div>
        @if (ViewBag.Error != null)
        {
            <p class="error-message">@ViewBag.Error</p>
        }

        <a asp-controller="Record"
           asp-action="Record"
           class="button-confirm"
           style="display:flex;
          justify-content:center;
          align-items:center;
          text-decoration:none;">
            Back to Record
        </a>
 </div>


