

@model Payment.Models.Cost
@{
    ViewData["Title"] = "Record";
}
    <form class="form" asp-controller="Record" asp-action="Record" method="post" width="50px">
            <div class="title"><br><span>enter your today cost</span></div>
            <label>Date: <strong  name="Date"> @DateTime.Now.ToString("yyyy/MM/dd")</strong>
        </label>
        <label>
            name:
            <strong>@Context.Session.GetString("UserName")</strong>
        </label>

        <label>Type: <input class="input" name="TypeOfCost" placeholder="Type of cost"></label>

        <label>Price: <input class="input" name="Price" placeholder="Price"></label>
        
           
            <div class="login-with">
            </div>
            @if (ViewBag.Error != null)
            {
                <p class="error-message">@ViewBag.Error</p>
            }
          <button class="button-confirm" type="submit">Recording expenses</button>
        <button class="button-confirm"
                asp-controller="Report"
                asp-action="Report"
                formmethod="get">
            Report
        </button>
        <button class="button-confirm"
                type="button"
                onclick="location.href='@Url.Action("Login", "Login")'">
            Back to Login
        </button>
        </form>

