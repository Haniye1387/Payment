

@model Payment.Models.User
@{
    ViewData["Title"] = "Login";
}
<form class="form" asp-controller="Login" asp-action="Login" method="post" width="50px">
    <div class="title">Welcome<br><span>sign up to continue</span></div>
    <input class="input"  name="UserName" placeholder="Username" >
    <input class="input"  name="password" placeholder="Password" type="password">
    <div class="login-with">
       
       
       
    </div>
            @if (ViewBag.Error != null)
            {
                <p class="error-message">@ViewBag.Error</p>
            }

            <button class="button-confirm" type="submit">Let`s go →</button>

    <a asp-controller="ChangePassword" style="text-decoration: none;
       color: dimgray;"
               asp-action="ChangePassword">
               Do you forgot your pass?
            </a>


    <a asp-controller="Register" style="text-decoration: none;
       color: dimgray;"
               asp-action="Register">
                Did you sign up?
            </a>
       
        </form>

